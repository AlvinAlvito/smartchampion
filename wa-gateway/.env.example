# Port lokal gateway (hanya 127.0.0.1)
WA_GATEWAY_PORT=3031
# Sama persis dengan WA_GATEWAY_SECRET di .env aplikasi (min. 24 karakter acak)
WA_GATEWAY_SECRET=
# Webhook aplikasi Next (langsung ke port app, tidak lewat nginx)
WA_APP_HOOK_URL=http://127.0.0.1:3030/api/wa/hook
# Folder sesi login WhatsApp (izin 700, jangan dibagikan)
WA_AUTH_DIR=auth
# Batas kirim per nomor (opsional)
# WA_MAX_PER_MINUTE=12
# WA_MAX_PER_HOUR=120
# WA_MAX_PER_DAY=500
# WA_MAX_SAME_TEXT_CHATS=4
