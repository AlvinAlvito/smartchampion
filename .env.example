DATABASE_URL="mysql://root:root@localhost:3306/pelatihan_posi"
AUTH_SECRET="ganti-dengan-string-acak-panjang"
APP_URL="http://localhost:3000"
# Opsional: URL webhook khusus transaksi pelatihan (gunakan domain HTTPS publik saat production).
MIDTRANS_NOTIFICATION_URL=""

# Midtrans (sandbox). Kosongkan = mode simulasi pembayaran untuk lokal.
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""

# Izinkan tombol simulasi pembayaran di build produksi LOKAL (jangan di server sungguhan)
ALLOW_PAYMENT_SIMULATION="false"

# AI generator soal game (Groq) — https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODELS="openai/gpt-oss-20b,qwen/qwen3.8-27b"
